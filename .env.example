# AuralArchive Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Everything is optional. Run `python app.py --show-paths` to see what is used.
#
# App data (settings, database, sign-ins, cache, logs, backups) is always in
# app/config, or /config in Docker. The built-in media folders are in app/media.

# Individual media folders. Normally set these in Settings instead - a value
# here overrides config.txt and locks the field in the Settings UI.
# Docker ignores these: it always uses /library, /downloads, /import and /work.
# AURALARCHIVE_LIBRARY_DIR=/mnt/audiobooks/library
# AURALARCHIVE_DOWNLOADS_DIR=/mnt/audiobooks/downloads
# AURALARCHIVE_IMPORT_DIR=/mnt/audiobooks/import
# AURALARCHIVE_WORK_DIR=/mnt/audiobooks/work

# AuralArchive refuses to start as root. Only override if you understand why.
# AURALARCHIVE_ALLOW_ROOT=false

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# SECRET_KEY: used to sign Flask sessions. If unset (or set to the placeholder),
# a random key is auto-generated on first run and persisted to secrets/secret_key.
# For production or multi-instance deployments, set this explicitly so all
# instances share the same key and sessions survive restarts.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-random-key-here
LOG_LEVEL=INFO

# FLASK_DEBUG: Flask debug mode, for development only.
# FLASK_DEBUG=false

# HTTPS_ENABLED=true        secure cookies when served over HTTPS
# TRUSTED_PROXY_COUNT=1     number of proxies whose X-Forwarded-* headers are trusted

# Extra origins allowed to open live-update connections (default: same origin).
# CORS_ALLOWED_ORIGINS=https://audiobooks.example.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Override if needed (default: {data folder}/database/auralarchive.db)
# DATABASE_URL=sqlite:////path/to/auralarchive.db
